{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "feature-to-pr-factory:ticket-implementer",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run-tests-before-done.sh"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/limit-review-rounds.sh"
            ]
          }
        ]
      }
    ]
  }
}
